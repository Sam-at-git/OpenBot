#!/opt/python/bin/python
"""New mail from an IMAP mailbox into this computer's folder, with nothing sent anywhere else.

The mailbox is read, never changed: messages are fetched with BODY.PEEK so they stay unread, and
nothing is moved or deleted. Each new message lands in its own folder under DEST/FOLDER/<uid>/:

    message.eml     the message exactly as the server sent it
    message.json    from, to, cc, subject, date, message id, and the attachments' names
    body.txt        the text of the message (the plain part, or the HTML part as text)
    attachments/    each attachment, under its own name

and one line per message is appended to DEST/FOLDER/index.jsonl, so a reader can see what is new
without opening every folder. Where it got to is kept in DEST/FOLDER/.state.json: a later run fetches
only what arrived since. The first run, and a run after the server renumbered the folder, starts
SINCE_DAYS back.

The password is read from the environment (MAIL_PASSWORD by default), never from the command line,
so it is not in the command's record. Prints one JSON line: {"ok": true, "new": n, ...} or
{"ok": false, "error": "..."}.

    mail-fetch --host imap.qq.com --user me@qq.com --folder INBOX --dest mail
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import email
import email.policy
import imaplib
import json
import os
import re
import socket
import ssl
import sys
import time
from html.parser import HTMLParser
from pathlib import Path

MAX_ATTACHMENTS_BYTES = 50 * 1024 * 1024


def imap_utf7(name: str) -> str:
    """A folder name in IMAP's modified UTF-7 (RFC 3501 5.1.3), so 收件箱 or 已发送 can be selected."""
    out: list[str] = []
    pending: list[str] = []

    def flush() -> None:
        if pending:
            raw = "".join(pending).encode("utf-16-be")
            out.append("&" + base64.b64encode(raw).decode().rstrip("=").replace("/", ",") + "-")
            pending.clear()

    for char in name:
        if 0x20 <= ord(char) <= 0x7E:
            flush()
            out.append("&-" if char == "&" else char)
        else:
            pending.append(char)
    flush()
    return "".join(out)


def quoted(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def safe_name(name: str, fallback: str) -> str:
    """A file name that stays inside its folder: no separators, no leading dots, bounded length."""
    cleaned = re.sub(r"[\x00-\x1f/\\:*?\"<>|]", "_", name or "").strip().lstrip(".")
    return (cleaned or fallback)[:150]


class _Text(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []
        self.skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style"):
            self.skip += 1
        if tag in ("br", "p", "div", "tr", "li", "h1", "h2", "h3", "h4"):
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag in ("script", "style") and self.skip:
            self.skip -= 1

    def handle_data(self, data):
        if not self.skip:
            self.parts.append(data)


def html_text(html: str) -> str:
    parser = _Text()
    parser.feed(html)
    text = "".join(parser.parts)
    return re.sub(r"\n\s*\n+", "\n\n", text).strip()


def body_text(message: email.message.EmailMessage) -> str:
    part = message.get_body(preferencelist=("plain", "html"))
    if part is None:
        return ""
    try:
        content = part.get_content()
    except Exception:  # an undeclared or broken charset
        payload = part.get_payload(decode=True) or b""
        content = payload.decode("utf-8", errors="replace")
    return html_text(content) if part.get_content_type() == "text/html" else content


def save_message(raw: bytes, uid: int, folder_dir: Path) -> dict:
    """Write one message to `folder_dir/<uid>/` and return its index line."""
    message = email.message_from_bytes(raw, policy=email.policy.default)
    target = folder_dir / str(uid)
    (target / "attachments").mkdir(parents=True, exist_ok=True)
    (target / "message.eml").write_bytes(raw)
    (target / "body.txt").write_text(body_text(message), encoding="utf-8")

    attachments: list[dict] = []
    total = 0
    for index, part in enumerate(message.iter_attachments(), start=1):
        name = safe_name(part.get_filename() or "", f"attachment-{index}")
        payload = part.get_payload(decode=True) or b""
        if total + len(payload) > MAX_ATTACHMENTS_BYTES:
            attachments.append({"name": name, "bytes": len(payload), "skipped": "too large"})
            continue
        total += len(payload)
        path = target / "attachments" / name
        if path.exists():
            path = path.with_name(f"{index}-{name}")
        path.write_bytes(payload)
        attachments.append({"name": path.name, "bytes": len(payload)})

    header = lambda key: str(message.get(key, "") or "")  # noqa: E731
    details = {
        "uid": uid,
        "subject": header("subject"),
        "from": header("from"),
        "to": header("to"),
        "cc": header("cc"),
        "date": header("date"),
        "message_id": header("message-id"),
        "attachments": attachments,
    }
    (target / "message.json").write_text(
        json.dumps(details, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    return {
        "uid": uid,
        "dir": str(target),
        "subject": details["subject"],
        "from": details["from"],
        "date": details["date"],
        "attachments": len(attachments),
    }


def connect(args: argparse.Namespace) -> imaplib.IMAP4:
    context = ssl.create_default_context()
    if args.security == "ssl":
        return imaplib.IMAP4_SSL(args.host, args.port, ssl_context=context, timeout=30)
    imap = imaplib.IMAP4(args.host, args.port, timeout=30)
    if args.security == "starttls":
        imap.starttls(ssl_context=context)
    return imap


def identify(imap: imaplib.IMAP4) -> None:
    """Some servers (163, 126) refuse SELECT until the client says who it is (RFC 2971 ID)."""
    if "ID" not in imap.capabilities:
        return
    imaplib.Commands.setdefault("ID", ("NONAUTH", "AUTH", "SELECTED"))
    try:
        imap._simple_command("ID", '("name" "openbot-mail-fetch" "version" "1")')
    except imaplib.IMAP4.error:
        pass


def fetch(args: argparse.Namespace) -> dict:
    password = os.environ.get(args.password_env, "")
    if not password:
        raise SystemExit(report({"ok": False, "error": f"{args.password_env} is not set."}, 2))

    folder_dir = Path(args.dest).expanduser() / safe_name(args.folder, "INBOX")
    folder_dir.mkdir(parents=True, exist_ok=True)
    state_path = folder_dir / ".state.json"
    state = json.loads(state_path.read_text()) if state_path.exists() else {}

    started = time.monotonic()
    imap = connect(args)
    try:
        imap.login(args.user, password)
        identify(imap)
        status, _ = imap.select(quoted(imap_utf7(args.folder)), readonly=True)
        if status != "OK":
            return {"ok": False, "error": f"The folder {args.folder} could not be opened."}
        validity = int((imap.response("UIDVALIDITY")[1] or [b"0"])[0] or 0)

        last = int(state.get("last_uid", 0)) if state.get("uidvalidity") == validity else 0
        if last:
            status, data = imap.uid("SEARCH", None, f"UID {last + 1}:*")
        else:
            since = (dt.date.today() - dt.timedelta(days=args.since_days)).strftime("%d-%b-%Y")
            status, data = imap.uid("SEARCH", None, "SINCE", since)
        if status != "OK":
            return {"ok": False, "error": "The mailbox could not be searched."}
        uids = sorted(int(uid) for uid in (data[0] or b"").split() if int(uid) > last)

        saved: list[dict] = []
        for uid in uids[: args.max]:
            if time.monotonic() - started > args.time_budget:
                break
            status, parts = imap.uid("FETCH", str(uid), "(BODY.PEEK[])")
            raw = next((p[1] for p in parts or [] if isinstance(p, tuple)), None)
            if status != "OK" or raw is None:
                continue
            line = save_message(raw, uid, folder_dir)
            saved.append(line)
            with (folder_dir / "index.jsonl").open("a", encoding="utf-8") as index:
                index.write(json.dumps(line, ensure_ascii=False) + "\n")
            # Kept after every message, so a run cut short resumes where it stopped.
            state = {"uidvalidity": validity, "last_uid": uid}
            state_path.write_text(json.dumps(state))
        if not saved and not last:
            # Nothing in the first window: start from the newest message from now on.
            newest = max(uids) if uids else 0
            state_path.write_text(json.dumps({"uidvalidity": validity, "last_uid": newest}))
        return {
            "ok": True,
            "folder": args.folder,
            "dir": str(folder_dir),
            "new": len(saved),
            "remaining": max(0, len(uids) - len(saved)),
            "saved": saved,
        }
    finally:
        try:
            imap.logout()
        except Exception:
            pass


def report(result: dict, code: int = 0) -> int:
    print(json.dumps(result, ensure_ascii=False))
    return code


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--host", required=True)
    parser.add_argument("--port", type=int, default=993)
    parser.add_argument("--security", choices=["ssl", "starttls", "plain"], default="ssl")
    parser.add_argument("--user", required=True)
    parser.add_argument("--folder", default="INBOX")
    parser.add_argument("--dest", default="mail")
    parser.add_argument("--max", type=int, default=50, help="most messages one run saves")
    parser.add_argument("--since-days", type=int, default=7, help="how far back a first run looks")
    parser.add_argument("--time-budget", type=float, default=90, help="seconds before stopping")
    parser.add_argument("--password-env", default="MAIL_PASSWORD")
    args = parser.parse_args()
    try:
        return report(fetch(args))
    except imaplib.IMAP4.error as error:
        text = str(error).replace(os.environ.get(args.password_env, "") or "\0", "***")
        return report({"ok": False, "error": f"The server refused: {text}"}, 1)
    except (socket.timeout, TimeoutError):
        return report({"ok": False, "error": f"{args.host} did not answer in time."}, 1)
    except (OSError, ssl.SSLError) as error:
        return report({"ok": False, "error": f"Could not reach {args.host}: {error}"}, 1)


if __name__ == "__main__":
    sys.exit(main())
